# backend/.env 로 복사해서 값 채우기 (cp .env.example .env)
# 공공데이터포털(data.go.kr)·카카오에서 발급받은 키를 입력

# 카카오모빌리티 길찾기 REST 키 (길찾기 기능에 필요)
KAKAO_REST_API_KEY=

# 심평원 병원정보 일반 인증키 (import_hira 에서 사용, 선택)
HIRA_SERVICE_KEY=

# E-Gen 응급의료기관 일반 인증키 (import_emergency 에서 사용)
EGEN_SERVICE_KEY=

# Anthropic API 키 (증상 키워드 후보 LLM 생성: manage.py generate_keywords, 선택)
ANTHROPIC_API_KEY=
